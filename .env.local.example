# ==============================================================================
# FOUNDR — Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha com seus valores reais.
# NUNCA commite o arquivo .env.local no git.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE (obrigatório)
# Dashboard → Settings → API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=seu-anon-key-aqui

# ------------------------------------------------------------------------------
# STRIPE (obrigatório para planos pagos)
# Dashboard → Developers → API Keys
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Webhook Secret — gerado em Dashboard → Webhooks → Adicionar endpoint
# Endpoint URL: https://seu-dominio.vercel.app/api/stripe/webhook
# Eventos: checkout.session.completed, customer.subscription.deleted, customer.subscription.updated
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs — crie os produtos no Stripe Dashboard:
# Produto "Foundr Básico" → R$14,99/mês → copie o Price ID abaixo
STRIPE_PRICE_ID_BASIC=price_...
NEXT_PUBLIC_STRIPE_PRICE_ID_BASIC=price_...

# Produto "Foundr Premium" → R$59,99/mês → copie o Price ID abaixo
STRIPE_PRICE_ID_PREMIUM=price_...
NEXT_PUBLIC_STRIPE_PRICE_ID_PREMIUM=price_...

# ------------------------------------------------------------------------------
# APP URL (obrigatório em produção)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://seu-dominio.vercel.app

# Durante o desenvolvimento, use:
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# GOOGLE AI (para geração de bio com IA)
# console.cloud.google.com → APIs → Gemini API
# ------------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=...

# ==============================================================================
# CONFIGURAÇÃO DO SUPABASE — Passo a Passo
# ==============================================================================
#
# 1. HABILITAR PROVIDER EMAIL/SENHA:
#    Dashboard → Authentication → Providers → Email → Enable
#    Desative "Confirm email" para testes locais (reative em produção)
#
# 2. CONFIGURAR SMTP (Resend) para e-mails transacionais:
#    Dashboard → Settings → Authentication → SMTP Settings
#    - Enable Custom SMTP: ON
#    - Host: smtp.resend.com
#    - Port: 465
#    - User: resend
#    - Password: re_... (sua API key do Resend)
#    - Sender email: noreply@seu-dominio.com
#
# 3. CONFIGURAR URLs DE REDIRECIONAMENTO:
#    Dashboard → Authentication → URL Configuration
#    Site URL: https://seu-dominio.vercel.app
#    Redirect URLs (adicione ambas):
#    - http://localhost:3000/auth/callback
#    - https://seu-dominio.vercel.app/auth/callback
#
# 4. EXECUTAR MIGRATIONS SQL:
#    Dashboard → SQL Editor → Cole o conteúdo de migration.sql e execute
#
# ==============================================================================
# CONFIGURAÇÃO DO STRIPE — Passo a Passo
# ==============================================================================
#
# 1. Crie uma conta em stripe.com
# 2. Dashboard → Products → Add Product
#    - Nome: "Foundr Básico" | Preço: R$14,99/mês | Recorrente
#    - Nome: "Foundr Premium" | Preço: R$59,99/mês | Recorrente
# 3. Copie os Price IDs (price_...) para as variáveis acima
# 4. Para Pix, habilite em: Dashboard → Settings → Payment Methods → Pix
# 5. Configure o webhook:
#    Dashboard → Developers → Webhooks → Add endpoint
#    URL: https://seu-dominio.vercel.app/api/stripe/webhook
#    Eventos: checkout.session.completed, customer.subscription.deleted, customer.subscription.updated
# 6. Copie o Webhook Secret (whsec_...) para STRIPE_WEBHOOK_SECRET
# ==============================================================================
